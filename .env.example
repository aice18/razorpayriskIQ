# ==========================================
# Razorpay RiskIQ (Sentinel) Environment Config
# ==========================================

# Application Runtime Environment (development | staging | production)
ENV=development
DEBUG=false

# API Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security & Model API Keys
# Optional: If unset, RiskIQ automatically uses the deterministic audit-safe template fallback
ANTHROPIC_API_KEY=
SECRET_KEY=razorpay_riskiq_secret_key_prod_2026

# Online Feature Store & Redis Cluster (Set USE_REDIS=true to enable Redis backend)
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Event Streaming / Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=riskiq.transactions.v1
KAFKA_GROUP_ID=riskiq-scoring-group

# Risk Policy Engine Thresholds
SCORE_FLAG_THRESHOLD=0.35
SCORE_BLOCK_THRESHOLD=0.70
FP_UNIT_COST_INR=500.0
